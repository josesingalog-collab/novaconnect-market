# Tests d'intégration uniquement : ne jamais utiliser les clés de .env.local.
# Option locale (par défaut) : démarrez Supabase, puis récupérez les clés avec
# `npx supabase status`.
INTEGRATION_TEST_TARGET=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Option projet de test Supabase distant : remplacez INTEGRATION_TEST_TARGET par remote,
# renseignez un projet exclusivement réservé aux tests et confirmez explicitement son usage.
# INTEGRATION_SUPABASE_PROJECT_REF=
# INTEGRATION_REMOTE_TEST_ACKNOWLEDGEMENT=dedicated-test-project
