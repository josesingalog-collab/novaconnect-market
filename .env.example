# ============================================================
# SAVPAY — Variables d'environnement (NOMS SEULEMENT)
# Ne jamais commiter de vraies valeurs. Copier vers .env.local en dev.
# ============================================================

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVICE ROLE : serveur uniquement. JAMAIS côté client. JAMAIS dans NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stockage (buckets privés créés via migrations Phase 2) ---
STORAGE_BUCKET_PRODUCT_FILES=product-files
STORAGE_BUCKET_VENDOR_LOGOS=vendor-logos

# --- Paiements ---
# Valeurs autorisées en V1 : mock (aucune fausse intégration réelle ne doit être ajoutée)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=

# --- Environnement ---
NODE_ENV=development
